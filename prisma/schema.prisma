// BLA Logistics Platform — Prisma schema
// Design: docs/database-schema.md. New tables live in a dedicated `app`
// PostgreSQL schema; the legacy `public` schema is left untouched.
// Phase 1: identity & access models only (docs/database-schema.md §1).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

/// Single login identity for every human in the system.
/// Never hard-deleted; lifecycle via `status` (ACTIVE / SUSPENDED / DEACTIVATED).
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  /// bcrypt hash from the auth library; null until an invited user sets a password.
  passwordHash        String?
  fullName            String
  phone               String?
  /// FK to FileAsset (Phase 10 platform model); plain column until then.
  avatarFileId        String?
  status              String    @default("ACTIVE")
  emailVerifiedAt     DateTime?
  mustChangePassword  Boolean   @default(false)
  mfaEnabled          Boolean   @default(false)
  mfaSecretEncrypted  String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roles             UserRole[]
  memberships       WarehouseMembership[]
  managedWarehouses Warehouse[]           @relation("WarehouseManager")
  sessions          Session[]
  loginAttempts     LoginAttempt[]
  auditLogs         AuditLog[]
  rolesAssigned     UserRole[]            @relation("UserRoleAssignedBy")
  invitationsSent   UserInvitation[]      @relation("InvitationSentBy")
  vendorLinks       VendorUser[]
  customerProfile   Customer?

  pricingRulesCreated     PricingRule[]               @relation("PricingRuleCreatedBy")
  vendorsVerified         Vendor[]                    @relation("VendorVerifiedBy")
  vendorsCreated          Vendor[]                    @relation("VendorCreatedBy")
  vendorUsersInvited      VendorUser[]                @relation("VendorUserInvitedBy")
  vendorAddressesApproved VendorAddress[]             @relation("VendorAddressApprovedBy")
  vendorDocumentsUploaded VendorDocument[]            @relation("VendorDocumentUploadedBy")
  vendorDocumentsReviewed VendorDocument[]            @relation("VendorDocumentReviewedBy")
  vendorAssignmentsMade   VendorWarehouseAssignment[] @relation("VendorAssignmentBy")
  customersCreated        Customer[]                  @relation("CustomerCreatedBy")
  ordersCreated           Order[]                     @relation("OrderCreatedBy")
  ordersApproved          Order[]                     @relation("OrderApprovedBy")
  packagesWeighed         Package[]                   @relation("PackageWeightMeasuredBy")
  labelsPrinted           PackageLabel[]              @relation("PackageLabelPrintedBy")
  trackingEventsActed     TrackingEvent[]             @relation("TrackingEventActor")
  inventoryReceived       InventoryRecord[]           @relation("InventoryReceivedBy")
  inventoryReleased       InventoryRecord[]           @relation("InventoryReleasedBy")
  inventoryMovementsActed InventoryMovement[]         @relation("InventoryMovementActor")
  custodiesHeld           PackageCustody[]            @relation("CustodyUser")
  stockMovementsPerformed StockMovement[]             @relation("StockMovementPerformedBy")
  handoversInitiated      HandoverBatch[]             @relation("HandoverInitiatedBy")
  handoversConfirmed      HandoverBatch[]             @relation("HandoverConfirmedBy")
  handoverBatchesFrom     HandoverBatch[]             @relation("HandoverBatchFromUser")
  handoverBatchesTo       HandoverBatch[]             @relation("HandoverBatchToUser")

  driverProfile              Driver?
  transfersCreated           Transfer[]           @relation("TransferCreatedBy")
  transfersApproved          Transfer[]           @relation("TransferApprovedBy")
  transfersSupervised        Transfer[]           @relation("TransferDispatchSupervisor")
  manifestsGenerated         TransferManifest[]   @relation("ManifestGeneratedBy")
  transferItemsReceived      TransferItem[]       @relation("TransferItemReceivedBy")
  transferScansPerformed     TransferScan[]       @relation("TransferScanBy")
  tripStopsRecorded          TripStop[]           @relation("TripStopRecordedBy")
  vehicleMaintenanceRecorded VehicleMaintenance[] @relation("VehicleMaintenanceRecordedBy")

  deliveryBatchesCreated   DeliveryBatch[]         @relation("DeliveryBatchCreatedBy")
  deliveryBatchesClosed    DeliveryBatch[]         @relation("DeliveryBatchClosedBy")
  deliveryAssignmentsMade  DeliveryAssignment[]    @relation("DeliveryAssignmentBy")
  deliveryAttemptsRecorded DeliveryAttempt[]       @relation("DeliveryAttemptRecordedBy")
  proofsRecorded           ProofOfDelivery[]       @relation("ProofRecordedBy")
  codCollectionsMade       DeliveryCodCollection[] @relation("CodCollectedBy")
  returnsRequested         ReturnRequest[]         @relation("ReturnRequestedBy")
  returnsAuthorised        ReturnRequest[]         @relation("ReturnAuthorisedBy")
  returnsReceived          ReturnRequest[]         @relation("ReturnReceivedBy")
  returnsInspected         ReturnRequest[]         @relation("ReturnInspectedBy")
  returnsCompleted         ReturnRequest[]         @relation("ReturnCompletedBy")
  returnsHandedTo          ReturnRequest[]         @relation("ReturnHandedTo")
  invoicesIssued           Invoice[]               @relation("InvoiceIssuedBy")
  paymentsRecorded         Payment[]               @relation("PaymentRecordedBy")
  allocationsMade          PaymentAllocation[]     @relation("AllocationBy")
  ledgerEntriesActed       LedgerTransaction[]     @relation("LedgerActor")
  ledgerEntriesApproved    LedgerTransaction[]     @relation("LedgerApprovedBy")
  remittancesSubmitted     CodRemittance[]         @relation("RemittanceSubmittedBy")
  remittancesVerified      CodRemittance[]         @relation("RemittanceVerifiedBy")
  remittancesResolved      CodRemittance[]         @relation("RemittanceResolvedBy")
  settlementsPrepared      VendorSettlement[]      @relation("SettlementPreparedBy")
  settlementsApproved      VendorSettlement[]      @relation("SettlementApprovedBy")
  refundsRequested         Refund[]                @relation("RefundRequestedBy")
  refundsApproved          Refund[]                @relation("RefundApprovedBy")
  refundsProcessed         Refund[]                @relation("RefundProcessedBy")
  adjustmentsCreated       FinancialAdjustment[]   @relation("AdjustmentCreatedBy")
  adjustmentsApproved      FinancialAdjustment[]   @relation("AdjustmentApprovedBy")

  tasksCreated            Task[]                @relation("TaskCreatedBy")
  tasksAssigned           Task[]                @relation("TaskAssignee")
  taskComments            TaskComment[]         @relation("TaskCommentAuthor")
  incidentsReported       Incident[]            @relation("IncidentReporter")
  incidentsAssigned       Incident[]            @relation("IncidentAssignee")
  incidentsProposed       Incident[]            @relation("IncidentResolutionProposedBy")
  incidentsApproved       Incident[]            @relation("IncidentResolutionApprovedBy")
  incidentNotes           IncidentNote[]        @relation("IncidentNoteAuthor")
  incidentEvidence        IncidentEvidence[]    @relation("IncidentEvidenceUploadedBy")
  ticketsRaised           SupportTicket[]       @relation("TicketRaisedBy")
  ticketsAssigned         SupportTicket[]       @relation("TicketAssignedTo")
  ticketsResolved         SupportTicket[]       @relation("TicketResolvedBy")
  ticketMessages          SupportTicketMessage[] @relation("TicketMessageAuthor")
  notifications           Notification[]        @relation("NotificationUser")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceUser")

  @@index([phone])
  @@schema("app")
}

/// Named bundle of permissions. Data, not an enum, so roles are manageable
/// without a migration. Seeded with the ten spec roles.
model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
  memberships WarehouseMembership[]
  invitations UserInvitation[]

  @@schema("app")
}

/// One row per checkable capability (docs/role-permission-matrix.md §3).
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@schema("app")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@schema("app")
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@schema("app")
}

/// Auth.js database session, extended for revocation and forensics.
/// Suspension deletes session rows (enforcement); `revokedAt` is forensic.
model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
  @@schema("app")
}

/// The warehouse-scoping mechanism (adopted from the live legacy table).
/// `warehouseId` became a real FK when the Warehouse model landed in
/// Phase 2 (docs/database-schema.md §2).
/// A partial unique index on (userId, warehouseId, roleId) WHERE
/// revokedAt IS NULL — at most one ACTIVE membership per triple — lives
/// in migration 20261115173000_membership_active_unique; Prisma cannot
/// express partial indexes here (Phase 2 review P2-5).
model WarehouseMembership {
  id           String    @id @default(uuid())
  userId       String
  warehouseId  String
  roleId       String
  isPrimary    Boolean   @default(false)
  assignedById String?
  assignedAt   DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?
  notes        String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([warehouseId, revokedAt])
  @@schema("app")
}

/// Onboarding invitations. Only the token hash is stored.
/// status: PENDING / ACCEPTED / EXPIRED / REVOKED.
model UserInvitation {
  id          String    @id @default(uuid())
  email       String
  roleId      String
  warehouseId String?
  vendorId    String?
  /// Intra-vendor role granted on acceptance (OWNER / MANAGER /
  /// BOOKING_STAFF / ACCOUNTS_STAFF) when the invitation is vendor-scoped.
  vendorRole  String?
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  role      Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User       @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: Restrict)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  vendor    Vendor?    @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@schema("app")
}

/// Password-reset / email-verification tokens (Auth.js pattern).
/// The `token` column stores the token HASH; rows are consumed on use.
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@schema("app")
}

/// Append-only audit trail: logins, account/role changes, denied access,
/// sensitive actions. No update/delete path (enforced by DB trigger).
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  warehouseId String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@schema("app")
}

/// Login attempt record for rate limiting and failed-login monitoring
/// (docs/security-architecture.md §2).
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 2: warehouses (docs/database-schema.md §2, docs/warehouse-workflow.md)
// ---------------------------------------------------------------------------

/// A physical warehouse / hub. `code` is unique and immutable (enforced in
/// the service and by a database trigger). Warehouses are never deleted —
/// lifecycle is ACTIVE / INACTIVE / ARCHIVED via `status`.
/// `type` CHECK: MAIN / REGIONAL / LOCAL_HUB / COLLECTION_CENTER /
/// RETURN_CENTER. `status` CHECK: ACTIVE / INACTIVE / ARCHIVED.
/// `district` is a required first-class field: routing and destination
/// auto-match key off it (this closes the legacy Phase 3c gap).
model Warehouse {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  type             String   @default("REGIONAL")
  district         String
  city             String
  province         String
  country          String   @default("NP")
  contactPhone     String?
  email            String?
  managerUserId    String?
  capacityPackages Int?
  capacityWeightKg Decimal? @db.Decimal(12, 2)
  status           String   @default("INACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  manager     User?                     @relation("WarehouseManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  addresses   WarehouseAddress[]
  zones       WarehouseZone[]
  hours       WarehouseOperatingHours[]
  memberships WarehouseMembership[]
  invitations UserInvitation[]

  serviceAreas        ServiceArea[]
  codRemittances      CodRemittance[]             @relation("RemittanceWarehouse")
  vendorAssignments   VendorWarehouseAssignment[]
  ordersOrigin        Order[]                     @relation("OrderOriginWarehouse")
  shipmentsOrigin     Shipment[]                  @relation("ShipmentOriginWarehouse")
  shipmentsDest       Shipment[]                  @relation("ShipmentDestinationWarehouse")
  packagesCurrent     Package[]                   @relation("PackageCurrentWarehouse")
  trackingEvents      TrackingEvent[]
  inventoryRecords    InventoryRecord[]
  movementsFrom       InventoryMovement[]         @relation("MovementFromWarehouse")
  movementsTo         InventoryMovement[]         @relation("MovementToWarehouse")
  packageCustodies    PackageCustody[]
  stockItems          StockItem[]
  stockMovements      StockMovement[]
  handoverBatches     HandoverBatch[]             @relation("HandoverBatchWarehouse")
  handoverBatchesFrom HandoverBatch[]             @relation("HandoverBatchFromWarehouse")
  handoverBatchesTo   HandoverBatch[]             @relation("HandoverBatchToWarehouse")

  driversHome     Driver[]       @relation("DriverHomeWarehouse")
  vehiclesHome    Vehicle[]      @relation("VehicleHomeWarehouse")
  transfersOrigin Transfer[]     @relation("TransferOriginWarehouse")
  transfersDest   Transfer[]     @relation("TransferDestinationWarehouse")
  transferScans   TransferScan[] @relation("TransferScanWarehouse")

  deliveryBatches DeliveryBatch[] @relation("DeliveryBatchWarehouse")
  returnRequests  ReturnRequest[] @relation("ReturnWarehouse")
  tasks           Task[]          @relation("TaskWarehouse")
  incidents       Incident[]      @relation("IncidentWarehouse")

  @@index([district])
  @@index([status])
  @@schema("app")
}

/// Address detail for a warehouse. `kind` CHECK: PRIMARY / GATE / BILLING.
/// One address per kind per warehouse (@@unique below).
model WarehouseAddress {
  id           String   @id @default(uuid())
  warehouseId  String
  kind         String   @default("PRIMARY")
  addressLine1 String
  addressLine2 String?
  city         String
  district     String
  province     String
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, kind])
  @@schema("app")
}

/// A functional area inside a warehouse. `kind` CHECK: RECEIVING /
/// INSPECTION / SORTING / STORAGE / DISPATCH / DAMAGED / RETURNS.
/// Zones are deactivated, never deleted, once they have held packages.
model WarehouseZone {
  id               String   @id @default(uuid())
  warehouseId      String
  code             String
  name             String
  kind             String
  capacityPackages Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locations StorageLocation[]

  @@unique([warehouseId, code])
  @@schema("app")
}

/// Rack/shelf/bin level storage. `fullCode` is the canonical scannable
/// code, unique platform-wide, e.g. WH-KTM-01/ZONE-STO/RACK-03/SHELF-02.
model StorageLocation {
  id               String   @id @default(uuid())
  zoneId           String
  rack             String
  shelf            String?
  bin              String?
  fullCode         String   @unique
  capacityPackages Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  zone WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  inventoryRecords InventoryRecord[]
  movementsFrom    InventoryMovement[] @relation("MovementFromLocation")
  movementsTo      InventoryMovement[] @relation("MovementToLocation")
  packageCustodies PackageCustody[]

  @@index([zoneId])
  @@schema("app")
}

/// Per-weekday opening hours. Times are minutes-from-midnight to avoid
/// timezone-ambiguous `time` columns; display in Asia/Kathmandu.
/// Pure configuration: Cascade from the warehouse is permitted
/// (docs/database-schema.md §0 composition exception).
model WarehouseOperatingHours {
  id          String  @id @default(uuid())
  warehouseId String
  dayOfWeek   Int
  opensAt     Int?
  closesAt    Int?
  isClosed    Boolean @default(false)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, dayOfWeek])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 3: routing & pricing configuration (docs/database-schema.md §11)
// ---------------------------------------------------------------------------

/// A deliverable geography. Routing resolves a booking's destination
/// district to the warehouse that serves it. `@@unique([district, name])`.
model ServiceArea {
  id                 String   @id @default(uuid())
  name               String
  district           String
  city               String?
  province           String
  servingWarehouseId String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  servingWarehouse Warehouse       @relation(fields: [servingWarehouseId], references: [id], onDelete: Restrict)
  orders           Order[]
  shipments        Shipment[]
  pricingDest      PricingRule[]   @relation("PricingDestinationArea")
  pricingOrigin    PricingRule[]   @relation("PricingOriginArea")
  deliveryBatches  DeliveryBatch[]

  @@unique([district, name])
  @@index([district])
  @@index([servingWarehouseId])
  @@schema("app")
}

/// A sellable delivery product (STANDARD / EXPRESS / SAME_DAY).
model ShippingService {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  estimatedDaysMin    Int?
  estimatedDaysMax    Int?
  requiresProofMethod String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pricingRules PricingRule[]
  shipments    Shipment[]

  @@schema("app")
}

/// Tariff configuration — prices are data, never code (spec §6.3).
/// Rule resolution picks the most specific active rule for
/// (service, origin area, destination area, billable weight) at booking
/// time; the result is snapshotted onto the Shipment.
model PricingRule {
  id                       String    @id @default(uuid())
  shippingServiceId        String
  originServiceAreaId      String?
  destinationServiceAreaId String?
  minWeightKg              Decimal?  @db.Decimal(10, 3)
  maxWeightKg              Decimal?  @db.Decimal(10, 3)
  baseRatePaisa            BigInt
  perKgRatePaisa           BigInt
  codFeePercent            Decimal?  @db.Decimal(5, 2)
  volumetricDivisor        Int       @default(5000)
  effectiveFrom            DateTime  @default(now())
  effectiveTo              DateTime?
  isActive                 Boolean   @default(true)
  createdById              String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  shippingService        ShippingService @relation(fields: [shippingServiceId], references: [id], onDelete: Restrict)
  originServiceArea      ServiceArea?    @relation("PricingOriginArea", fields: [originServiceAreaId], references: [id], onDelete: Restrict)
  destinationServiceArea ServiceArea?    @relation("PricingDestinationArea", fields: [destinationServiceAreaId], references: [id], onDelete: Restrict)
  createdBy              User            @relation("PricingRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  shipments              Shipment[]

  @@index([shippingServiceId, isActive])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 3: vendors & customers (docs/database-schema.md §3)
// ---------------------------------------------------------------------------

/// A business customer organisation (spec §14.1). Never deleted —
/// lifecycle is the verification status:
/// PENDING_VERIFICATION / UNDER_REVIEW / APPROVED / REJECTED /
/// SUSPENDED / INACTIVE. Only APPROVED vendors can create bookings.
model Vendor {
  id                 String    @id @default(uuid())
  businessName       String
  registrationNumber String?
  contactName        String
  email              String?
  phone              String
  verificationStatus String    @default("PENDING_VERIFICATION")
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNotes  String?
  billingPreference  String    @default("COD_OFFSET")
  creditLimitPaisa   BigInt?
  isActive           Boolean   @default(true)
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verifiedBy     User?                       @relation("VendorVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  createdBy      User                        @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  users          VendorUser[]
  addresses      VendorAddress[]
  documents      VendorDocument[]
  assignments    VendorWarehouseAssignment[]
  invitations    UserInvitation[]
  orders         Order[]
  financeAccount FinancialAccount?           @relation("VendorFinanceAccount")
  invoices       Invoice[]
  settlements    VendorSettlement[]
  paymentsMade   Payment[]                   @relation("PaymentPayerVendor")
  tickets        SupportTicket[]             @relation("TicketVendor")

  @@index([verificationStatus])
  @@index([businessName])
  @@schema("app")
}

/// Authorised employees of a vendor, with intra-vendor roles
/// (OWNER / MANAGER / BOOKING_STAFF / ACCOUNTS_STAFF — spec §14.2).
/// Every vendor-scoped query resolves the caller's vendor through this
/// table server-side; a vendor user never sees another vendor's rows.
model VendorUser {
  id          String   @id @default(uuid())
  vendorId    String
  userId      String
  vendorRole  String
  isActive    Boolean  @default(true)
  invitedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy User   @relation("VendorUserInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([vendorId, userId])
  @@index([userId, isActive])
  @@schema("app")
}

/// Pickup / billing / office addresses. Vendors pick up from APPROVED
/// pickup addresses (spec §4.7); approval is an Admin act.
model VendorAddress {
  id           String   @id @default(uuid())
  vendorId     String
  kind         String   @default("PICKUP")
  addressLine1 String
  addressLine2 String?
  city         String
  district     String
  province     String
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  contactName  String?
  contactPhone String?
  isApproved   Boolean  @default(false)
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor     Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("VendorAddressApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  orders     Order[] @relation("OrderPickupVendorAddress")

  @@index([vendorId, kind])
  @@schema("app")
}

/// Verification document metadata. The file itself lives in private
/// object storage (FileAsset lands with the platform phase); this row
/// is the reviewable metadata record: PENDING_REVIEW / APPROVED /
/// REJECTED. `storageKey` is unique when present.
model VendorDocument {
  id           String    @id @default(uuid())
  vendorId     String
  documentType String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  storageKey   String?   @unique
  sha256       String?
  status       String    @default("PENDING_REVIEW")
  uploadedById String
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation("VendorDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("VendorDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@schema("app")
}

/// A vendor's assigned company warehouse for a purpose (ORIGIN — the
/// warehouse its pickups/drop-offs route through when the pickup
/// address district does not resolve one).
model VendorWarehouseAssignment {
  id           String   @id @default(uuid())
  vendorId     String
  warehouseId  String
  kind         String   @default("ORIGIN")
  isActive     Boolean  @default(true)
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  assignedBy User      @relation("VendorAssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([vendorId, warehouseId, kind])
  @@index([vendorId, isActive])
  @@schema("app")
}

/// A sender/recipient person record, deduplicated on the normalised
/// phone (spec §14.3). Recipients do NOT need an account to track a
/// parcel — `userId` is an optional link if they later register.
model Customer {
  id              String   @id @default(uuid())
  fullName        String
  phone           String
  normalizedPhone String   @unique
  email           String?  @unique
  userId          String?  @unique
  mergedIntoId    String?
  isMerged        Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  mergedInto   Customer?         @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Customer[]        @relation("CustomerMerge")
  createdBy    User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  addresses    CustomerAddress[]
  orders       Order[]           @relation("OrderSenderCustomer")
  packages     Package[]         @relation("PackageRecipientCustomer")
  invoices     Invoice[]
  paymentsMade Payment[]         @relation("PaymentPayerCustomer")
  tickets      SupportTicket[] @relation("TicketCustomer")
  notifications Notification[] @relation("NotificationRecipientCustomer")

  @@index([fullName])
  @@schema("app")
}

/// Customer addresses (PICKUP / DELIVERY / HOME) with the Nepal
/// recipient addressing fields (spec §6.2).
model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  kind         String   @default("DELIVERY")
  addressLine1 String
  addressLine2 String?
  city         String
  district     String
  province     String
  municipality String?
  wardNumber   String?
  landmark     String?
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   Order[]  @relation("OrderPickupCustomerAddress")

  @@index([customerId])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 3: orders, shipments & packages (docs/database-schema.md §4–§5)
// One chain only: Order (booking request) → Shipment (consignment) →
// Package (physical parcel). The brief's "BookingRequest/BookingItem"
// are this Order/OrderItem pair (roadmap Phase 3, schema doc §4).
// ---------------------------------------------------------------------------

/// The booking request. Sender data is snapshotted (the printed receipt
/// shows what was declared even if the Customer record is later
/// corrected). Order-level payment fields are a derived roll-up cache;
/// the authoritative money records land in Phase 7.
model Order {
  id                       String    @id @default(uuid())
  orderNumber              String    @unique
  vendorId                 String?
  customerId               String?
  createdById              String
  createdByRole            String
  senderName               String
  senderPhone              String
  senderEmail              String?
  originWarehouseId        String?
  destinationDistrict      String
  destinationServiceAreaId String?
  approvalStatus           String    @default("APPROVED")
  approvedById             String?
  approvedAt               DateTime?
  approvalNote             String?
  status                   String    @default("CONFIRMED")
  cancelRequestedById      String?
  cancelApprovedById       String?
  cancelReason             String?
  cancelStage              String?
  cancelChargesPaisa       BigInt    @default(0)
  cancelledAt              DateTime?
  paymentMethod            String
  paymentStatus            String    @default("UNPAID")
  pickupMethod             String
  pickupVendorAddressId    String?
  pickupCustomerAddressId  String?
  deliveryInstructions     String?
  notes                    String?
  scheduledAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  vendor                 Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  customer               Customer?           @relation("OrderSenderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  createdBy              User                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy             User?               @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  originWarehouse        Warehouse?          @relation("OrderOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destinationServiceArea ServiceArea?        @relation(fields: [destinationServiceAreaId], references: [id], onDelete: Restrict)
  pickupVendorAddress    VendorAddress?      @relation("OrderPickupVendorAddress", fields: [pickupVendorAddressId], references: [id], onDelete: Restrict)
  pickupCustomerAddress  CustomerAddress?    @relation("OrderPickupCustomerAddress", fields: [pickupCustomerAddressId], references: [id], onDelete: Restrict)
  items                  OrderItem[]
  shipments              Shipment[]
  packages               Package[]
  trackingEvents         TrackingEvent[]
  returnRequests         ReturnRequest[]
  invoices               Invoice[]
  payments               Payment[]
  ledgerTransactions     LedgerTransaction[]
  invoiceLines           InvoiceLine[]
  incidents              Incident[]      @relation("IncidentOrder")
  tickets                SupportTicket[] @relation("TicketOrder")

  @@index([vendorId, createdAt])
  @@index([customerId])
  @@index([approvalStatus])
  @@index([status, createdAt])
  @@index([destinationDistrict])
  @@schema("app")
}

/// What was booked, line by line. Items describe intent; the physical
/// parcels generated from them are Packages (one package per unit).
model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  description    String
  quantity       Int
  unitPricePaisa BigInt?
  weightKg       Decimal? @db.Decimal(10, 3)
  sku            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageItems PackageItem[]

  @@schema("app")
}

/// The consignment moving under one contract. `status` is a roll-up
/// derived from its Packages, recomputed by the lifecycle service on
/// every package transition — never set directly. Charge snapshots
/// freeze the price as quoted at booking (spec §6.3).
/// routeKind: LAST_MILE / INTER_WAREHOUSE / UNROUTED (destination
/// district has no serving warehouse yet — the booking is HELD in this
/// visible state, never silently misrouted).
model Shipment {
  id                       String    @id @default(uuid())
  shipmentNumber           String    @unique
  orderId                  String
  kind                     String    @default("FORWARD")
  originalShipmentId       String?
  originWarehouseId        String
  destinationWarehouseId   String?
  destinationServiceAreaId String?
  routeKind                String
  shippingServiceId        String
  pricingRuleId            String?
  shippingChargePaisa      BigInt
  codAmountPaisa           BigInt    @default(0)
  status                   String    @default("ACTIVE")
  expectedDeliveryAt       DateTime?
  totalWeightKg            Decimal?  @db.Decimal(10, 3)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  originalShipment       Shipment?               @relation("ShipmentOriginal", fields: [originalShipmentId], references: [id], onDelete: Restrict)
  derivedShipments       Shipment[]              @relation("ShipmentOriginal")
  originWarehouse        Warehouse               @relation("ShipmentOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse?              @relation("ShipmentDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  destinationServiceArea ServiceArea?            @relation(fields: [destinationServiceAreaId], references: [id], onDelete: Restrict)
  shippingService        ShippingService         @relation(fields: [shippingServiceId], references: [id], onDelete: Restrict)
  pricingRule            PricingRule?            @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  packages               Package[]
  trackingEvents         TrackingEvent[]
  codCollections         DeliveryCodCollection[]
  returnRequests         ReturnRequest[]
  invoiceLines           InvoiceLine[]
  tasks                  Task[]                  @relation("TaskRelatedShipment")
  incidents              Incident[]              @relation("IncidentShipment")

  @@index([orderId])
  @@index([originWarehouseId, status])
  @@index([destinationWarehouseId, status])
  @@schema("app")
}

/// The canonical physical parcel — one row per physical box, each with
/// its own tracking ID and history. Recipient data is snapshotted per
/// package. Five separate status fields (schema doc §5): operational
/// status is written ONLY by the package lifecycle service.
model Package {
  id                      String    @id @default(uuid())
  trackingId              String    @unique
  shipmentId              String
  orderId                 String
  recipientName           String
  recipientPhone          String
  recipientAltPhone       String?
  recipientEmail          String?
  recipientCustomerId     String?
  deliveryAddress         String
  deliveryCity            String
  deliveryDistrict        String
  municipality            String?
  wardNumber              String?
  landmark                String?
  deliveryLatitude        Decimal?  @db.Decimal(10, 7)
  deliveryLongitude       Decimal?  @db.Decimal(10, 7)
  declaredWeightKg        Decimal   @db.Decimal(10, 3)
  actualWeightKg          Decimal?  @db.Decimal(10, 3)
  volumetricWeightKg      Decimal?  @db.Decimal(10, 3)
  billableWeightKg        Decimal?  @db.Decimal(10, 3)
  weightMeasuredById      String?
  weightMeasuredAt        DateTime?
  lengthCm                Decimal?  @db.Decimal(10, 2)
  widthCm                 Decimal?  @db.Decimal(10, 2)
  heightCm                Decimal?  @db.Decimal(10, 2)
  declaredValuePaisa      BigInt?
  description             String
  category                String    @default("PACKAGE")
  isFragile               Boolean   @default(false)
  handlingInstructions    String?
  restrictedGoodsDeclared Boolean   @default(false)
  codAmountPaisa          BigInt    @default(0)
  currentWarehouseId      String?
  operationalStatus       String    @default("BOOKED")
  condition               String    @default("GOOD")
  paymentStatus           String    @default("NOT_APPLICABLE")
  deliveryStatus          String    @default("NOT_STARTED")
  exceptionStatus         String    @default("NONE")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  shipment            Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order               Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recipientCustomer   Customer?              @relation("PackageRecipientCustomer", fields: [recipientCustomerId], references: [id], onDelete: Restrict)
  currentWarehouse    Warehouse?             @relation("PackageCurrentWarehouse", fields: [currentWarehouseId], references: [id], onDelete: Restrict)
  weightMeasuredBy    User?                  @relation("PackageWeightMeasuredBy", fields: [weightMeasuredById], references: [id], onDelete: Restrict)
  items               PackageItem[]
  labels              PackageLabel[]
  trackingEvents      TrackingEvent[]
  inventoryRecords    InventoryRecord[]
  inventoryMovements  InventoryMovement[]
  custodies           PackageCustody[]
  handoverLines       CustodyHandover[]
  transferItems       TransferItem[]
  ledgerTransactions  LedgerTransaction[]
  deliveryAssignments DeliveryAssignment[]
  deliveryAttempts    DeliveryAttempt[]
  proofsOfDelivery    ProofOfDelivery[]
  codCollection       DeliveryCodCollection?
  returnRequests      ReturnRequest[]
  invoiceLines        InvoiceLine[]
  tasks               Task[]                @relation("TaskRelatedPackage")
  incidents           Incident[]            @relation("IncidentPackage")
  tickets             SupportTicket[]       @relation("TicketPackage")

  @@index([shipmentId])
  @@index([currentWarehouseId, operationalStatus])
  @@index([operationalStatus, createdAt])
  @@index([recipientPhone])
  @@index([recipientCustomerId])
  @@schema("app")
}

/// Physical contents of one package (which booked line it fulfils).
model PackageItem {
  id                 String   @id @default(uuid())
  packageId          String
  orderItemId        String?
  description        String
  quantity           Int
  declaredValuePaisa BigInt?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  package   Package    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@schema("app")
}

/// The printed label record. Regenerating a label never changes the
/// package's trackingId. `fileId` becomes a FileAsset FK in the
/// platform phase; it is a plain column until then.
model PackageLabel {
  id              String    @id @default(uuid())
  packageId       String
  labelCode       String    @unique
  qrPayload       String
  fileId          String?
  printCount      Int       @default(0)
  lastPrintedAt   DateTime?
  lastPrintedById String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  package       Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  lastPrintedBy User?   @relation("PackageLabelPrintedBy", fields: [lastPrintedById], references: [id], onDelete: Restrict)

  @@schema("app")
}

/// Append-only package/shipment/order history (schema doc §4 — the
/// brief's "PackageStatusHistory": the unified TrackingEvent stream
/// carries the previous/new operational-status pair for every package
/// transition). No `updatedAt`, no update/delete path; protected by
/// the append-only trigger like AuditLog. Transfer/trip context FKs
/// landed with the Phase 5 transport models.
model TrackingEvent {
  id                   String   @id @default(uuid())
  packageId            String?
  shipmentId           String?
  orderId              String?
  transferId           String?
  tripId               String?
  deliveryAssignmentId String?
  subjectType          String
  eventType            String
  previousStatus       String?
  newStatus            String?
  occurredAt           DateTime @default(now())
  actorId              String?
  actorRole            String?
  warehouseId          String?
  notes                String?
  source               String   @default("WEB")
  idempotencyKey       String?  @unique
  createdAt            DateTime @default(now())

  package            Package?            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  shipment           Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transfer           Transfer?           @relation(fields: [transferId], references: [id], onDelete: Restrict)
  trip               Trip?               @relation(fields: [tripId], references: [id], onDelete: Restrict)
  deliveryAssignment DeliveryAssignment? @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Restrict)
  actor              User?               @relation("TrackingEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  inventoryRecords   InventoryRecord[]   @relation("InventoryReceivingEvent")
  inventoryMovements InventoryMovement[]
  packageCustodies   PackageCustody[]

  @@index([packageId, occurredAt])
  @@index([shipmentId, occurredAt])
  @@index([orderId, occurredAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 4 — Warehouse operations: parcel inventory, movements, custody,
// handovers, and the strictly separate supplies inventory
// (docs/database-schema.md §6, docs/inventory-and-custody.md).
// ---------------------------------------------------------------------------

/// Parcel inventory — one row per package per continuous warehouse stay.
/// `releasedAt = null` means physically there now. A package can never
/// be in two warehouses' stock at once: a partial unique index on
/// (packageId) WHERE releasedAt IS NULL lives in the Phase 4 hardening
/// migration (Prisma cannot express partial indexes). Inventory exists
/// only because a receiving scan created it (invariant I3): the
/// receiving TrackingEvent is a mandatory FK.
model InventoryRecord {
  id                 String    @id @default(uuid())
  packageId          String
  warehouseId        String
  storageLocationId  String?
  receivingEventId   String
  receivedAt         DateTime  @default(now())
  receivedById       String
  conditionOnArrival String    @default("GOOD")
  releasedAt         DateTime?
  releasedById       String?
  releaseReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  package         Package             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation?    @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  receivingEvent  TrackingEvent       @relation("InventoryReceivingEvent", fields: [receivingEventId], references: [id], onDelete: Restrict)
  receivedBy      User                @relation("InventoryReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  releasedBy      User?               @relation("InventoryReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  movements       InventoryMovement[]

  @@index([warehouseId, releasedAt])
  @@index([packageId, receivedAt])
  @@index([storageLocationId, releasedAt])
  @@schema("app")
}

/// Append-only record of every physical/logical parcel movement inside
/// or out of a warehouse (schema doc §6 movement vocabulary). No
/// `updatedAt`; protected by the append-only trigger like TrackingEvent.
model InventoryMovement {
  id                String   @id @default(uuid())
  packageId         String
  inventoryRecordId String?
  type              String
  fromWarehouseId   String?
  toWarehouseId     String?
  fromLocationId    String?
  toLocationId      String?
  actorId           String
  reason            String?
  trackingEventId   String?
  createdAt         DateTime @default(now())

  package         Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  inventoryRecord InventoryRecord? @relation(fields: [inventoryRecordId], references: [id], onDelete: Restrict)
  fromWarehouse   Warehouse?       @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse?       @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  fromLocation    StorageLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation      StorageLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  actor           User             @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: Restrict)
  trackingEvent   TrackingEvent?   @relation(fields: [trackingEventId], references: [id], onDelete: Restrict)

  @@index([packageId, createdAt])
  @@index([toWarehouseId, createdAt])
  @@schema("app")
}

/// The custody chain — who is accountable for a package right now is
/// the open row (`endedAt IS NULL`); history is the closed rows. Rows
/// are closed, never edited afterwards. A partial unique index on
/// (packageId) WHERE endedAt IS NULL (hardening migration) makes
/// "exactly one accountable custodian" a database fact, and a CHECK
/// constraint enforces that exactly the fields matching custodianType
/// are set.
model PackageCustody {
  id                String    @id @default(uuid())
  packageId         String
  custodianType     String
  custodianUserId   String?
  warehouseId       String?
  storageLocationId String?
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  handoverId        String?
  trackingEventId   String?
  createdAt         DateTime  @default(now())

  package           Package           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  custodianUser     User?             @relation("CustodyUser", fields: [custodianUserId], references: [id], onDelete: Restrict)
  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  storageLocation   StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  handover          CustodyHandover?  @relation("CustodyBeganWithHandover", fields: [handoverId], references: [id], onDelete: Restrict)
  trackingEvent     TrackingEvent?    @relation(fields: [trackingEventId], references: [id], onDelete: Restrict)
  handoverLinesFrom CustodyHandover[] @relation("HandoverFromCustody")
  handoverLinesTo   CustodyHandover[] @relation("HandoverToCustody")

  @@index([packageId, endedAt])
  @@index([custodianUserId, endedAt])
  @@index([warehouseId, endedAt])
  @@schema("app")
}

/// One physical handover act covering many packages (schema doc §6).
/// `warehouseId` is the operational context warehouse — every Phase 4
/// batch happens inside one warehouse, and scoping/listing key off it.
/// If confirmedCount != expectedCount when the batch is closed, the
/// batch goes DISPUTED and the shortfall is audit/event recorded; the
/// Incident record itself lands in Phase 8. `evidenceFileId` from the
/// schema doc is deferred with FileAsset (platform phase), as in
/// Phase 3.
model HandoverBatch {
  id                String    @id @default(uuid())
  warehouseId       String
  fromCustodianType String
  fromUserId        String?
  fromWarehouseId   String?
  toCustodianType   String
  toUserId          String?
  toWarehouseId     String?
  expectedCount     Int
  confirmedCount    Int       @default(0)
  status            String    @default("PENDING")
  initiatedById     String
  confirmedById     String?
  createdAt         DateTime  @default(now())
  confirmedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  warehouse     Warehouse         @relation("HandoverBatchWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  fromUser      User?             @relation("HandoverBatchFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse?        @relation("HandoverBatchFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toUser        User?             @relation("HandoverBatchToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse?        @relation("HandoverBatchToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  initiatedBy   User              @relation("HandoverInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  confirmedBy   User?             @relation("HandoverConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  lines         CustodyHandover[]
  incidents     Incident[]        @relation("IncidentHandoverBatch")

  @@index([warehouseId, status])
  @@index([status, createdAt])
  @@schema("app")
}

/// One package's line inside a HandoverBatch. Custody moves only when
/// the receiver confirms the line: the old custody closes and the new
/// one opens (pointing back at this line via `handoverId`).
model CustodyHandover {
  id            String    @id @default(uuid())
  batchId       String
  packageId     String
  fromCustodyId String
  toCustodyId   String?
  status        String    @default("PENDING")
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  batch          HandoverBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  package        Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  fromCustody    PackageCustody   @relation("HandoverFromCustody", fields: [fromCustodyId], references: [id], onDelete: Restrict)
  toCustody      PackageCustody?  @relation("HandoverToCustody", fields: [toCustodyId], references: [id], onDelete: Restrict)
  beganCustodies PackageCustody[] @relation("CustodyBeganWithHandover")

  @@unique([batchId, packageId])
  @@index([packageId])
  @@schema("app")
}

/// Supplies catalogue — company consumables (boxes, tape, labels),
/// kept strictly separate from parcel inventory (schema doc §6):
/// no tracking IDs, no custody, no customer linkage. quantityOnHand
/// is maintained transactionally from StockMovement rows and can
/// never go negative (CHECK in the hardening migration).
model StockItem {
  id             String   @id @default(uuid())
  warehouseId    String
  sku            String
  name           String
  unit           String   @default("PCS")
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([warehouseId, sku])
  @@index([warehouseId, isActive])
  @@schema("app")
}

/// Append-only supplies ledger. Before/after quantity snapshots make
/// the ledger self-auditing: every row proves the running balance.
model StockMovement {
  id             String   @id @default(uuid())
  stockItemId    String
  warehouseId    String
  type           String
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  reference      String?
  performedById  String
  createdAt      DateTime @default(now())

  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  performedBy User      @relation("StockMovementPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([stockItemId, createdAt])
  @@index([warehouseId, createdAt])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 5 — Transfers & transport: drivers, vehicles, transfers with
// manifests and scans, trips (docs/database-schema.md §7,
// docs/transfer-workflow.md, docs/driver-workflow.md).
// ---------------------------------------------------------------------------

/// The operational driver profile; the login identity is the linked
/// User (1:1, schema doc §7 "Driver"). `employmentStatus` is set by
/// driver managers; `availabilityStatus` is written only by the
/// assignment services from real work (trip dispatch/completion),
/// never from login state. `profilePhotoFileId` stays a plain column
/// until FileAsset lands (platform phase), like PackageLabel.fileId.
/// `incidentId` columns elsewhere follow the same deferral pattern.
model Driver {
  id                    String    @id @default(uuid())
  userId                String    @unique
  homeWarehouseId       String
  licenseNumber         String
  licenseCategory       String?
  licenseExpiry         DateTime  @db.Date
  profilePhotoFileId    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  employmentStatus      String    @default("ACTIVE")
  availabilityStatus    String    @default("AVAILABLE")
  currentTripId         String?
  lastSeenAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  homeWarehouse       Warehouse            @relation("DriverHomeWarehouse", fields: [homeWarehouseId], references: [id], onDelete: Restrict)
  currentTrip         Trip?                @relation("DriverCurrentTrip", fields: [currentTripId], references: [id], onDelete: Restrict)
  capabilities        DriverCapability[]
  trips               Trip[]               @relation("TripDriver")
  transfers           Transfer[]           @relation("TransferDriver")
  vehiclesDefault     Vehicle[]            @relation("VehicleAssignedDriver")
  deliveryBatches     DeliveryBatch[]      @relation("DeliveryBatchRider")
  deliveryAssignments DeliveryAssignment[] @relation("DeliveryAssignmentDriver")
  financeAccount      FinancialAccount?    @relation("DriverFinanceAccount")
  codRemittances      CodRemittance[]      @relation("RemittanceDriver")

  @@index([homeWarehouseId, availabilityStatus])
  @@index([licenseExpiry])
  @@schema("app")
}

/// Capability-based assignment (schema doc §7): a driver without the
/// LINEHAUL capability can never be assigned a Trip — checked in the
/// transfer service at assignment time, not just in the UI.
model DriverCapability {
  id         String   @id @default(uuid())
  driverId   String
  capability String
  createdAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, capability])
  @@schema("app")
}

/// Fleet vehicle (schema doc §7). `status` replaces the legacy
/// is_active + status pair: AVAILABLE / ASSIGNED / ON_TRIP /
/// MAINTENANCE / OFFLINE. The service refuses trip assignment for
/// expired insurance/registration, failed inspection, or any
/// non-AVAILABLE status (driver-workflow.md §4).
model Vehicle {
  id                 String    @id @default(uuid())
  registration       String    @unique
  type               String
  capacityKg         Decimal?  @db.Decimal(10, 2)
  capacityVolumeM3   Decimal?  @db.Decimal(8, 2)
  homeWarehouseId    String?
  status             String    @default("AVAILABLE")
  insuranceExpiry    DateTime? @db.Date
  registrationExpiry DateTime? @db.Date
  inspectionStatus   String    @default("VALID")
  assignedDriverId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  homeWarehouse       Warehouse?           @relation("VehicleHomeWarehouse", fields: [homeWarehouseId], references: [id], onDelete: Restrict)
  assignedDriver      Driver?              @relation("VehicleAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  trips               Trip[]               @relation("TripVehicle")
  transfers           Transfer[]           @relation("TransferVehicle")
  maintenance         VehicleMaintenance[]
  deliveryAssignments DeliveryAssignment[] @relation("DeliveryAssignmentVehicle")

  @@index([status])
  @@index([homeWarehouseId, status])
  @@schema("app")
}

model VehicleMaintenance {
  id           String    @id @default(uuid())
  vehicleId    String
  kind         String
  scheduledAt  DateTime
  completedAt  DateTime?
  costPaisa    BigInt?
  notes        String?
  nextDueAt    DateTime?
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("VehicleMaintenanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([vehicleId, scheduledAt])
  @@schema("app")
}

/// Inter-warehouse transfer header (schema doc §7): origin/destination,
/// the fifteen-state lifecycle plus CANCELLED, crew assignment, and the
/// one Trip that executes it. Closure invariant: CLOSED requires
/// RECONCILED, which requires every item RECEIVED or DAMAGED
/// (accounted) — enforced by TransferService; counts are always
/// counted from items, never denormalised.
model Transfer {
  id                     String    @id @default(uuid())
  transferNumber         String    @unique
  originWarehouseId      String
  destinationWarehouseId String
  status                 String    @default("DRAFT")
  driverId               String?
  vehicleId              String?
  tripId                 String?   @unique
  dispatchSupervisorId   String?
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  expectedArrivalAt      DateTime?
  dispatchedAt           DateTime?
  arrivedAt              DateTime?
  reconciledAt           DateTime?
  closedAt               DateTime?
  instructions           String?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  originWarehouse      Warehouse         @relation("TransferOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse         @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  driver               Driver?           @relation("TransferDriver", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle              Vehicle?          @relation("TransferVehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  trip                 Trip?             @relation("TransferTrip", fields: [tripId], references: [id], onDelete: Restrict)
  dispatchSupervisor   User?             @relation("TransferDispatchSupervisor", fields: [dispatchSupervisorId], references: [id], onDelete: Restrict)
  createdBy            User              @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy           User?             @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items                TransferItem[]
  manifest             TransferManifest?
  executedTrip         Trip?             @relation("TripTransfer")
  trackingEvents       TrackingEvent[]
  tasks                Task[]          @relation("TaskRelatedTransfer")
  incidents            Incident[]      @relation("IncidentTransfer")

  @@index([originWarehouseId, status])
  @@index([destinationWarehouseId, status])
  @@index([driverId, status])
  @@schema("app")
}

/// One manifested package on a transfer. A package may appear on only
/// one OPEN transfer at a time — enforced by a trigger in the Phase 5
/// hardening migration (the predicate spans two tables, so Prisma
/// cannot express it as an index). `incidentId` links the Phase 8
/// Incident once that model lands; plain column until then.
model TransferItem {
  id                String    @id @default(uuid())
  transferId        String
  packageId         String
  expectedCondition String    @default("GOOD")
  itemStatus        String    @default("EXPECTED")
  receivedCondition String?
  receivedById      String?
  receivedAt        DateTime?
  discrepancyNote   String?
  incidentId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transfer   Transfer       @relation(fields: [transferId], references: [id], onDelete: Restrict)
  package    Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  receivedBy User?          @relation("TransferItemReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  incident   Incident?      @relation("TransferItemIncident", fields: [incidentId], references: [id], onDelete: Restrict)
  scans      TransferScan[]

  @@unique([transferId, packageId])
  @@index([packageId])
  @@index([transferId, itemStatus])
  @@schema("app")
}

/// The frozen loading document. Once generated, the item set it
/// snapshots can change only through an authorised amendment that
/// writes an AuditLog row (and a TrackingEvent on the package) — the
/// counts here are updated by that amendment path only, and
/// regeneration after dispatch is impossible (service-enforced).
model TransferManifest {
  id            String    @id @default(uuid())
  transferId    String    @unique
  manifestCode  String    @unique
  generatedById String
  generatedAt   DateTime  @default(now())
  packageCount  Int
  totalWeightKg Decimal   @db.Decimal(12, 3)
  totalCodPaisa BigInt    @default(0)
  sealedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  generatedBy User     @relation("ManifestGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  @@schema("app")
}

/// Append-only physical scan evidence for loading/unloading
/// (schema doc §7). The unique idempotencyKey makes a duplicate scan
/// return the original scan instead of double-counting (Scenario 7);
/// rows are trigger-protected against update/delete like the other
/// ledgers.
model TransferScan {
  id             String   @id @default(uuid())
  transferItemId String
  scanType       String
  warehouseId    String
  scannedById    String
  scannedAt      DateTime @default(now())
  idempotencyKey String   @unique
  notes          String?
  createdAt      DateTime @default(now())

  transferItem TransferItem @relation(fields: [transferItemId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation("TransferScanWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  scannedBy    User         @relation("TransferScanBy", fields: [scannedById], references: [id], onDelete: Restrict)

  @@index([transferItemId, scanType])
  @@schema("app")
}

/// One line-haul journey executing one Transfer (schema doc §7).
/// Manual TripStop checkpoints are the reliable progress mechanism;
/// GPS is optional garnish and no workflow step depends on it.
model Trip {
  id                 String    @id @default(uuid())
  tripNumber         String    @unique
  transferId         String    @unique
  driverId           String
  vehicleId          String
  status             String    @default("ASSIGNED")
  plannedDepartureAt DateTime?
  actualDepartureAt  DateTime?
  expectedArrivalAt  DateTime?
  actualArrivalAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transfer         Transfer        @relation("TripTransfer", fields: [transferId], references: [id], onDelete: Restrict)
  onTransfer       Transfer?       @relation("TransferTrip")
  driver           Driver          @relation("TripDriver", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle          Vehicle         @relation("TripVehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  stops            TripStop[]
  currentForDriver Driver[]        @relation("DriverCurrentTrip")
  trackingEvents   TrackingEvent[]
  incidents        Incident[]      @relation("IncidentTrip")

  @@index([driverId, status])
  @@index([vehicleId, status])
  @@schema("app")
}

/// Manual checkpoint on a Trip (replaces legacy `checkpoints`).
model TripStop {
  id           String    @id @default(uuid())
  tripId       String
  sequence     Int
  label        String
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  plannedAt    DateTime?
  passedAt     DateTime?
  recordedById String
  notes        String?
  createdAt    DateTime  @default(now())

  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)
  recordedBy User @relation("TripStopRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([tripId, sequence])
  @@index([tripId, createdAt])
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Phase 6 — Last-mile delivery: batches, per-package assignments,
// append-only attempts, proof of delivery, COD collection events and
// the return workflow (docs/database-schema.md §8,
// docs/delivery-workflow.md, docs/return-workflow.md).
// ---------------------------------------------------------------------------

/// A rider's grouped run for a shift/area (schema doc §8). The unit
/// of work the rider picks up, delivers from, and is reconciled
/// against at close-out (delivery-workflow.md §8): the batch closes
/// only when every assignment is accounted for.
model DeliveryBatch {
  id            String    @id @default(uuid())
  riderId       String
  warehouseId   String
  serviceAreaId String?
  batchDate     DateTime  @db.Date
  kind          String    @default("DELIVERY")
  status        String    @default("OPEN")
  createdById   String
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rider          Driver                  @relation("DeliveryBatchRider", fields: [riderId], references: [id], onDelete: Restrict)
  warehouse      Warehouse               @relation("DeliveryBatchWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  serviceArea    ServiceArea?            @relation(fields: [serviceAreaId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("DeliveryBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy       User?                   @relation("DeliveryBatchClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  assignments    DeliveryAssignment[]
  codCollections DeliveryCodCollection[]

  @@index([riderId, batchDate])
  @@index([warehouseId, status])
  @@schema("app")
}

/// One package ↔ one rider task (schema doc §8) — the single
/// per-package assignment system for the last mile. The OTP challenge
/// lives here (NOT on the proof record): the code is generated at
/// pickup, only its bcrypt hash is stored, wrong entries are counted
/// and lock after OTP_MAX_FAILURES (delivery-workflow.md §10); the
/// hash is copied onto the ProofOfDelivery as evidence when the
/// delivery is confirmed, and cleared here.
model DeliveryAssignment {
  id                   String    @id @default(uuid())
  packageId            String
  driverId             String
  batchId              String?
  vehicleId            String?
  kind                 String    @default("DELIVERY")
  status               String    @default("PENDING")
  assignedById         String
  assignedAt           DateTime  @default(now())
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  routeSequence        Int?
  deliveryInstructions String?
  failureNote          String?
  reassignedFromId     String?
  otpCodeHash          String?
  otpGeneratedAt       DateTime?
  otpExpiresAt         DateTime?
  otpFailedAttempts    Int       @default(0)
  otpLockedAt          DateTime?
  otpVerifiedAt        DateTime?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  package        Package                @relation(fields: [packageId], references: [id], onDelete: Restrict)
  driver         Driver                 @relation("DeliveryAssignmentDriver", fields: [driverId], references: [id], onDelete: Restrict)
  batch          DeliveryBatch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?               @relation("DeliveryAssignmentVehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedBy     User                   @relation("DeliveryAssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reassignedFrom DeliveryAssignment?    @relation("AssignmentReassignment", fields: [reassignedFromId], references: [id], onDelete: Restrict)
  reassignments  DeliveryAssignment[]   @relation("AssignmentReassignment")
  attempts       DeliveryAttempt[]
  proofs         ProofOfDelivery[]
  codCollection  DeliveryCodCollection?
  trackingEvents TrackingEvent[]
  incidents      Incident[]              @relation("IncidentDeliveryAssignment")

  @@index([driverId, status])
  @@index([packageId, status])
  @@index([batchId])
  @@schema("app")
}

/// Append-only record of every delivery visit (schema doc §8) —
/// replaces any failed-attempts counter. `attemptNumber` increments
/// per PACKAGE across riders and days (delivery-workflow.md §5).
/// No `updatedAt`; protected by the append-only trigger.
model DeliveryAttempt {
  id             String   @id @default(uuid())
  assignmentId   String
  packageId      String
  attemptNumber  Int
  attemptedAt    DateTime @default(now())
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  result         String
  failureReason  String?
  contactOutcome String?
  evidenceFileId String?
  nextAction     String   @default("NONE")
  notes          String?
  recordedById   String
  createdAt      DateTime @default(now())

  assignment DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  package    Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  recordedBy User               @relation("DeliveryAttemptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  proof      ProofOfDelivery?

  @@unique([assignmentId, attemptNumber])
  @@index([packageId, attemptedAt])
  @@schema("app")
}

/// The evidence that makes DELIVERED legal (schema doc §8): a package
/// in DELIVERED requires a non-superseded ProofOfDelivery (partial
/// unique index in the hardening migration) or an authorised
/// exception — the delivery service creates this row in the same
/// transaction as the DELIVERED transition, so there is no third
/// path. OTP fields carry the verified challenge as evidence; only
/// the hash is ever stored.
model ProofOfDelivery {
  id                      String    @id @default(uuid())
  packageId               String
  assignmentId            String
  attemptId               String?   @unique
  method                  String    @default("OTP")
  receivedByName          String?
  relationshipToRecipient String?
  otpCodeHash             String?
  otpExpiresAt            DateTime?
  otpVerifiedAt           DateTime?
  signatureFileId         String?
  photoFileId             String?
  latitude                Decimal?  @db.Decimal(10, 7)
  longitude               Decimal?  @db.Decimal(10, 7)
  deliveredAt             DateTime
  recordedById            String
  supersededById          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  package      Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  attempt      DeliveryAttempt?   @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  recordedBy   User               @relation("ProofRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  supersededBy ProofOfDelivery?   @relation("ProofSupersededBy", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   ProofOfDelivery[]  @relation("ProofSupersededBy")

  @@index([packageId])
  @@index([assignmentId])
  @@schema("app")
}

/// The delivery-time COD collection EVENT (Phase 6 scope per the
/// brief: the finance ledger — CODCollection, DriverRemittance,
/// LedgerTransaction — is Phase 7; this row is the immutable door
/// record Phase 7 will consume). Expected vs collected are recorded
/// exactly in paisa; a difference is a MISMATCH state with a required
/// explanation, never a silent adjustment. One collection per
/// package (`packageId` unique). Append-only: no `updatedAt`,
/// protected by the history trigger.
model DeliveryCodCollection {
  id             String   @id @default(uuid())
  packageId      String   @unique
  shipmentId     String
  assignmentId   String   @unique
  batchId        String?
  expectedPaisa  BigInt
  collectedPaisa BigInt
  status         String
  method         String   @default("CASH")
  collectedById  String
  collectedAt    DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())

  package     Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  shipment    Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  assignment  DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  batch       DeliveryBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  collectedBy User               @relation("CodCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)

  ledgerTransactions LedgerTransaction[]
  remittanceLines    CodRemittanceLine[]
  settlementLines    VendorSettlementLine[]
  incidents          Incident[]            @relation("IncidentCodCollection")

  @@index([collectedById, collectedAt])
  @@index([batchId])
  @@schema("app")
}

/// The return record (docs/return-workflow.md §2): a first-class
/// workflow linked to the original package/shipment/order — never a
/// replacement for them, and the original delivery history is never
/// touched. One OPEN return per package (partial unique index in
/// the hardening migration; return-workflow rule 6). The return
/// warehouse is the warehouse that receives the parcel back (the
/// delivery/destination warehouse for last-mile returns).
/// `returnNumber` comes from the `return_number_seq` sequence
/// (RTN-1001…, hardening migration), read inside the creating
/// transaction like order/shipment numbers.
model ReturnRequest {
  id                    String    @id @default(uuid())
  returnNumber          String    @unique
  packageId             String
  shipmentId            String
  orderId               String
  warehouseId           String
  reason                String
  status                String    @default("REQUESTED")
  requestedById         String
  authorisedById        String?
  authorisedAt          DateTime?
  rejectionReason       String?
  chargeBearer          String?
  chargeAmountPaisa     BigInt    @default(0)
  conditionAtInitiation String    @default("GOOD")
  conditionAtInspection String?
  receivedById          String?
  receivedAt            DateTime?
  inspectedById         String?
  inspectedAt           DateTime?
  completedById         String?
  completedAt           DateTime?
  handedToUserId        String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  package      Package       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  shipment     Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse    Warehouse     @relation("ReturnWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  requestedBy  User          @relation("ReturnRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  authorisedBy User?         @relation("ReturnAuthorisedBy", fields: [authorisedById], references: [id], onDelete: Restrict)
  receivedBy   User?         @relation("ReturnReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  inspectedBy  User?         @relation("ReturnInspectedBy", fields: [inspectedById], references: [id], onDelete: Restrict)
  completedBy  User?         @relation("ReturnCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  handedTo     User?         @relation("ReturnHandedTo", fields: [handedToUserId], references: [id], onDelete: Restrict)
  invoiceLines InvoiceLine[]

  @@index([packageId, status])
  @@index([warehouseId, status])
  @@index([shipmentId])
  @@schema("app")
}

/// Second-factor verification attempts against the public detailed
/// tracking view (docs/security-architecture.md §7: rate-limit
/// counters are database-backed). Every verification — success or
/// failure, known or unknown tracking id — writes one row; the
/// lockout is computed from the failed rows in the cooling window.
/// The presented phone is stored only as a SHA-256 hash.
model TrackingAccessAttempt {
  id         String   @id @default(uuid())
  trackingId String
  phoneHash  String
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([trackingId, createdAt])
  @@schema("app")
}

// ===========================================================================
// Phase 7 — Finance (docs/financial-workflow.md, docs/cod-reconciliation.md,
// docs/database-schema.md §9). Money is integer paisa in BigInt. COD is a
// liability until settled, never revenue (rule F0). The ledger is
// append-only: LedgerTransaction rows are never updated or deleted (DB
// triggers in the hardening migration); corrections are new linked
// entries. Balances are always derived by summing ledger entries — no
// stored, overwritable balance anywhere.
// ===========================================================================

/// Chart-of-accounts-lite (schema §9). Company accounts use the doc
/// codes (CASH_ON_HAND, BANK, COD_CLEARING, SHIPPING_REVENUE, …);
/// per-vendor payable and per-driver cash accounts carry
/// ownerVendorId / ownerDriverId and codes suffixed with the owner id,
/// created lazily by the finance services inside the posting
/// transaction.
model FinancialAccount {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  kind          String // ASSET / LIABILITY / REVENUE / EXPENSE
  ownerType     String   @default("COMPANY") // COMPANY / VENDOR / DRIVER
  ownerVendorId String?  @unique
  ownerDriverId String?  @unique
  currency      String   @default("NPR")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerVendor Vendor? @relation("VendorFinanceAccount", fields: [ownerVendorId], references: [id], onDelete: Restrict)
  ownerDriver Driver? @relation("DriverFinanceAccount", fields: [ownerDriverId], references: [id], onDelete: Restrict)

  ledgerTransactions LedgerTransaction[]

  @@index([kind, ownerType])
  @@schema("app")
}

/// The immutable spine (schema §9). One row per account leg; the legs
/// of one business operation share a `journalRef` and are written in a
/// single DB transaction with Σ DEBIT = Σ CREDIT (service-enforced,
/// test-asserted). `reference` is the unique per-entry reference from
/// `ledger_reference_seq`. An entry can be reversed at most once
/// (unique index on reversalOfId) by a mirror REVERSAL entry; the
/// original is never modified. No updatedAt — append-only.
model LedgerTransaction {
  id              String   @id @default(uuid())
  reference       String   @unique
  journalRef      String
  accountId       String
  direction       String // DEBIT / CREDIT
  amountPaisa     BigInt
  currency        String   @default("NPR")
  type            String // LEDGER_TYPES (lib/finance/domain)
  orderId         String?
  packageId       String?
  invoiceId       String?
  paymentId       String?
  codCollectionId String?
  remittanceId    String?
  settlementId    String?
  paymentMethod   String?
  occurredAt      DateTime
  actorId         String
  approvedById    String?
  reversalOfId    String?  @unique
  adjustmentId    String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())

  account       FinancialAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order         Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  package       Package?               @relation(fields: [packageId], references: [id], onDelete: Restrict)
  invoice       Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment       Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  codCollection DeliveryCodCollection? @relation(fields: [codCollectionId], references: [id], onDelete: Restrict)
  remittance    CodRemittance?         @relation(fields: [remittanceId], references: [id], onDelete: Restrict)
  settlement    VendorSettlement?      @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  actor         User                   @relation("LedgerActor", fields: [actorId], references: [id], onDelete: Restrict)
  approvedBy    User?                  @relation("LedgerApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  reversalOf    LedgerTransaction?     @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy    LedgerTransaction?     @relation("LedgerReversal")
  adjustment    FinancialAdjustment?   @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([journalRef])
  @@index([orderId])
  @@index([type, createdAt])
  @@index([codCollectionId])
  @@index([settlementId])
  @@schema("app")
}

/// A bill (schema §9). Vendor periodic invoices are generated by the
/// finance service from DELIVERED shipments' snapshotted charges
/// (Shipment.shippingChargePaisa — never recomputed from pricing
/// rules). Status is recomputed from allocations + settlement
/// coverage + applied adjustments by the finance service; OVERDUE is
/// derived at read time from dueAt. An issued invoice is immutable;
/// corrections are credit-note adjustments, voiding posts reversing
/// ledger entries.
model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  orderId       String?
  vendorId      String?
  customerId    String?
  subtotalPaisa BigInt
  discountPaisa BigInt    @default(0)
  taxPaisa      BigInt    @default(0)
  totalPaisa    BigInt
  currency      String    @default("NPR")
  status        String    @default("ISSUED")
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  issuedById    String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuedBy User      @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  lines              InvoiceLine[]
  allocations        PaymentAllocation[]
  payments           Payment[]
  ledgerTransactions LedgerTransaction[]
  settlementLines    VendorSettlementLine[]

  @@index([vendorId, issuedAt])
  @@index([status, dueAt])
  @@index([orderId])
  @@schema("app")
}

/// One billed charge on an invoice. A shipment's forward shipping
/// charge is billed at most once across all invoices (partial unique
/// index on shipmentId WHERE kind = 'SHIPPING_CHARGE' in the
/// hardening migration); a completed vendor-borne return charge
/// likewise (returnRequestId WHERE kind = 'RETURN_CHARGE').
model InvoiceLine {
  id              String   @id @default(uuid())
  invoiceId       String
  kind            String // SHIPPING_CHARGE / RETURN_CHARGE / ADJUSTMENT
  shipmentId      String?
  packageId       String?
  orderId         String?
  returnRequestId String?
  description     String
  amountPaisa     BigInt
  createdAt       DateTime @default(now())

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([shipmentId])
  @@schema("app")
}

/// A single act of paying (schema §9), independent of what it
/// settles. Idempotency: a unique idempotencyKey (Scenario 12) and a
/// partial unique index on transactionRef make duplicate submissions
/// return/collide on the original — a payment cannot be counted
/// twice. Amount/method/payer are immutable after recording (DB
/// trigger); only status moves, driven by finance services (refunds).
/// No card data is ever stored — gateway payments keep only the
/// provider reference.
model Payment {
  id              String    @id @default(uuid())
  orderId         String?
  invoiceId       String?
  payerType       String // CUSTOMER / VENDOR / COMPANY
  payerCustomerId String?
  payerVendorId   String?
  amountPaisa     BigInt
  currency        String    @default("NPR")
  method          String // PAYMENT_METHODS (lib/finance/domain)
  status          String    @default("PAID")
  transactionRef  String?
  idempotencyKey  String?   @unique
  gatewayProvider String?
  paidAt          DateTime?
  recordedById    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payerCustomer Customer? @relation("PaymentPayerCustomer", fields: [payerCustomerId], references: [id], onDelete: Restrict)
  payerVendor   Vendor?   @relation("PaymentPayerVendor", fields: [payerVendorId], references: [id], onDelete: Restrict)
  recordedBy    User      @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  allocations        PaymentAllocation[]
  ledgerTransactions LedgerTransaction[]
  refunds            Refund[]
  settlementsPaid    VendorSettlement[]  @relation("SettlementPayment")

  @@index([orderId])
  @@index([status, createdAt])
  @@index([payerVendorId, createdAt])
  @@schema("app")
}

/// Splits one Payment across Invoices (schema §9). Service invariant:
/// Σ allocations ≤ payment amount; an invoice's paid amount derives
/// from its allocations (+ settlement coverage + applied adjustment
/// credits) — never a hand-edited number.
model PaymentAllocation {
  id            String   @id @default(uuid())
  paymentId     String
  invoiceId     String
  amountPaisa   BigInt
  allocatedById String
  createdAt     DateTime @default(now())

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocatedBy User    @relation("AllocationBy", fields: [allocatedById], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@schema("app")
}

/// A rider handing collected COD to the company (cod-reconciliation
/// §1 steps 7–9; schema §9's DriverRemittance, named CodRemittance
/// per the Phase 7 brief). `declaredAmountPaisa` is what the rider
/// says they are handing over; `countedAmountPaisa` is what Finance
/// actually counted; `discrepancyPaisa` = counted − declared, stored
/// at verification time and never silently zeroed. Collections join
/// via CodRemittanceLine — DeliveryCodCollection itself is
/// append-only and is never mutated by finance.
model CodRemittance {
  id                  String    @id @default(uuid())
  remittanceNumber    String    @unique
  driverId            String
  submittedById       String
  warehouseId         String?
  declaredAmountPaisa BigInt
  countedAmountPaisa  BigInt?
  discrepancyPaisa    BigInt?
  status              String    @default("SUBMITTED")
  method              String    @default("CASH")
  notes               String?
  verifiedById        String?
  verifiedAt          DateTime?
  resolution          String?
  resolutionNote      String?
  resolvedById        String?
  resolvedAt          DateTime?
  submittedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  driver      Driver     @relation("RemittanceDriver", fields: [driverId], references: [id], onDelete: Restrict)
  submittedBy User       @relation("RemittanceSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  warehouse   Warehouse? @relation("RemittanceWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  verifiedBy  User?      @relation("RemittanceVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  resolvedBy  User?      @relation("RemittanceResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  lines              CodRemittanceLine[]
  ledgerTransactions LedgerTransaction[]
  incidents          Incident[]            @relation("IncidentRemittance")

  @@index([driverId, status])
  @@index([status, submittedAt])
  @@schema("app")
}

/// Coverage of one DeliveryCodCollection by one remittance. A
/// collection is covered by at most one live remittance
/// (codCollectionId @unique; rejecting a remittance deletes its
/// lines, freeing the collections — the header keeps the full
/// declared/counted/discrepancy history). `verifiedPaisa` is set at
/// verification: the amount of this collection confirmed into COD
/// clearing (collections are filled in line order when a counted
/// amount falls short — the tail stays unverified and excluded from
/// vendor settlement, cod-reconciliation §3.5).
model CodRemittanceLine {
  id              String   @id @default(uuid())
  remittanceId    String
  codCollectionId String   @unique
  expectedPaisa   BigInt
  collectedPaisa  BigInt
  verifiedPaisa   BigInt?
  createdAt       DateTime @default(now())

  remittance    CodRemittance         @relation(fields: [remittanceId], references: [id], onDelete: Restrict)
  codCollection DeliveryCodCollection @relation(fields: [codCollectionId], references: [id], onDelete: Restrict)

  @@index([remittanceId])
  @@schema("app")
}

/// Periodic payable settlement to a vendor (schema §9;
/// cod-reconciliation §4). netPayablePaisa = grossCodPaisa −
/// shippingChargesPaisa − otherDeductionsPaisa, computed by the
/// service at preparation and frozen as the approved figure at
/// approval. Items in discrepancy are excluded at preparation and
/// listed as pending — never netted quietly.
model VendorSettlement {
  id                   String    @id @default(uuid())
  settlementNumber     String    @unique
  vendorId             String
  periodStart          DateTime
  periodEnd            DateTime
  grossCodPaisa        BigInt
  shippingChargesPaisa BigInt
  otherDeductionsPaisa BigInt    @default(0)
  netPayablePaisa      BigInt
  status               String    @default("PENDING")
  preparedById         String
  approvedById         String?
  approvedAt           DateTime?
  settledAt            DateTime?
  paymentId            String?
  paymentRef           String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  preparedBy User     @relation("SettlementPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  payment    Payment? @relation("SettlementPayment", fields: [paymentId], references: [id], onDelete: Restrict)

  lines              VendorSettlementLine[]
  ledgerTransactions LedgerTransaction[]

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@schema("app")
}

/// Traceability, one row per settled obligation (schema §9). A
/// CODCollection may appear on at most one settlement line (partial
/// unique index in the hardening migration) — double-settlement is a
/// DB error, not a report discrepancy.
model VendorSettlementLine {
  id              String   @id @default(uuid())
  settlementId    String
  codCollectionId String?
  invoiceId       String?
  kind            String // COD_CREDIT / SHIPPING_CHARGE / DEDUCTION / ADJUSTMENT
  amountPaisa     BigInt
  description     String?
  createdAt       DateTime @default(now())

  settlement    VendorSettlement       @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  codCollection DeliveryCodCollection? @relation(fields: [codCollectionId], references: [id], onDelete: Restrict)
  invoice       Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([invoiceId])
  @@schema("app")
}

/// Money returned to a payer (financial-workflow §6). References the
/// original payment; amount ≤ its un-refunded remainder. Processing
/// posts the reversing ledger journal, moves the payment toward
/// REFUNDED / PARTIALLY_REFUNDED and reduces its allocations — the
/// original payment's amount and history are never edited.
model Refund {
  id               String    @id @default(uuid())
  paymentId        String
  amountPaisa      BigInt
  reason           String
  status           String    @default("REQUESTED")
  requestedById    String
  approvedById     String?
  processedById    String?
  processedAt      DateTime?
  ledgerJournalRef String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?   @relation("RefundApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  processedBy User?   @relation("RefundProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@schema("app")
}

/// The only legal way to change a financial outcome after the fact
/// (financial-workflow §5; schema §9). Four-eyes: approver ≠ creator
/// (service-enforced). Applying an adjustment creates ledger entries;
/// it never edits the target's amounts. Phase 7 applies INVOICE
/// credits (credit notes) and COD_COLLECTION shortfall write-offs
/// (against the COD_DISCREPANCY suspense account); other targets are
/// rejected at creation until their owning workflows land.
model FinancialAdjustment {
  id               String    @id @default(uuid())
  targetType       String // PAYMENT / INVOICE / COD_COLLECTION / SETTLEMENT / LEDGER
  targetId         String
  amountPaisa      BigInt
  reason           String
  status           String    @default("REQUESTED")
  createdById      String
  approvedById     String?
  appliedAt        DateTime?
  ledgerJournalRef String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy  User  @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  ledgerTransactions LedgerTransaction[]

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@schema("app")
}

// ============================================================================
// Phase 8 — Operations: tasks, incidents, support tickets, notifications
// (docs/database-schema.md §10; docs/exception-management.md; spec
// Parts 15–17). Vocabulary CHECKs, the number sequences and the
// append-only triggers live in the Phase 8 hardening migration.
// ============================================================================

/// Work management (spec Part 15) — distinct from DeliveryAssignment,
/// which is operational package work. A task never substitutes for a
/// package status update. Accountability timestamps are set by the
/// workflow transitions, never by hand.
model Task {
  id                  String    @id @default(uuid())
  title               String
  description         String?
  createdById         String
  assigneeId          String
  warehouseId         String?
  priority            String    @default("NORMAL")
  status              String    @default("DRAFT")
  dueAt               DateTime?
  relatedPackageId    String?
  relatedShipmentId   String?
  relatedTransferId   String?
  relatedIncidentId   String?
  relatedTicketId     String?
  acceptedAt          DateTime?
  submittedAt         DateTime?
  verifiedAt          DateTime?
  closedAt            DateTime?
  reassignmentReason  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdBy       User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee        User           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  warehouse       Warehouse?     @relation("TaskWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  relatedPackage  Package?       @relation("TaskRelatedPackage", fields: [relatedPackageId], references: [id], onDelete: Restrict)
  relatedShipment Shipment?      @relation("TaskRelatedShipment", fields: [relatedShipmentId], references: [id], onDelete: Restrict)
  relatedTransfer Transfer?      @relation("TaskRelatedTransfer", fields: [relatedTransferId], references: [id], onDelete: Restrict)
  relatedIncident Incident?      @relation("TaskRelatedIncident", fields: [relatedIncidentId], references: [id], onDelete: Restrict)
  relatedTicket   SupportTicket? @relation("TaskRelatedTicket", fields: [relatedTicketId], references: [id], onDelete: Restrict)
  comments        TaskComment[]

  @@index([assigneeId, status, dueAt])
  @@index([warehouseId, status])
  @@index([status, dueAt])
  @@schema("app")
}

/// Append-only in practice: comments are never edited; corrections
/// are new comments (schema doc §10). Protected by trigger.
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@schema("app")
}

/// The exceptions/incidents register (spec Part 16).
/// `sourceKey` is the idempotency key for AUTO-CREATED incidents:
/// each source event (a disputed handover batch, a COD discrepancy
/// on a remittance, a transfer item marked missing, a misroute flag
/// at a warehouse, a rider-displacing scan-back) owns exactly one
/// key, so a retry of the source operation can never raise a second
/// incident for the same event. Manual reports carry no sourceKey.
/// `investigationNotes` on the schema doc is realised as the
/// append-only IncidentNote thread — a single mutable String cannot
/// be an append-only record.
model Incident {
  id                     String    @id @default(uuid())
  incidentNumber         String    @unique
  category               String
  severity               String
  status                 String    @default("REPORTED")
  sourceKey              String?   @unique
  packageId              String?
  orderId                String?
  shipmentId             String?
  transferId             String?
  tripId                 String?
  warehouseId            String?
  codCollectionId        String?
  remittanceId           String?
  handoverBatchId        String?
  deliveryAssignmentId   String?
  reporterId             String
  assigneeId             String?
  responsibleTeam        String?
  description            String
  resolution             String?
  resolutionProposedById String?
  resolutionApprovedById String?
  acknowledgedAt         DateTime?
  resolvedAt             DateTime?
  closedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  package            Package?             @relation("IncidentPackage", fields: [packageId], references: [id], onDelete: Restrict)
  order              Order?               @relation("IncidentOrder", fields: [orderId], references: [id], onDelete: Restrict)
  shipment           Shipment?            @relation("IncidentShipment", fields: [shipmentId], references: [id], onDelete: Restrict)
  transfer           Transfer?            @relation("IncidentTransfer", fields: [transferId], references: [id], onDelete: Restrict)
  trip               Trip?                @relation("IncidentTrip", fields: [tripId], references: [id], onDelete: Restrict)
  warehouse          Warehouse?           @relation("IncidentWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  codCollection      DeliveryCodCollection? @relation("IncidentCodCollection", fields: [codCollectionId], references: [id], onDelete: Restrict)
  remittance         CodRemittance?       @relation("IncidentRemittance", fields: [remittanceId], references: [id], onDelete: Restrict)
  handoverBatch      HandoverBatch?       @relation("IncidentHandoverBatch", fields: [handoverBatchId], references: [id], onDelete: Restrict)
  deliveryAssignment DeliveryAssignment?  @relation("IncidentDeliveryAssignment", fields: [deliveryAssignmentId], references: [id], onDelete: Restrict)
  reporter           User                 @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee           User?                @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  resolutionProposedBy User?              @relation("IncidentResolutionProposedBy", fields: [resolutionProposedById], references: [id], onDelete: Restrict)
  resolutionApprovedBy User?              @relation("IncidentResolutionApprovedBy", fields: [resolutionApprovedById], references: [id], onDelete: Restrict)
  notes              IncidentNote[]
  evidence           IncidentEvidence[]
  tasks              Task[]               @relation("TaskRelatedIncident")
  transferItems      TransferItem[]       @relation("TransferItemIncident")

  @@index([status, severity])
  @@index([packageId])
  @@index([warehouseId, status])
  @@index([assigneeId, status])
  @@schema("app")
}

/// Append-only investigation thread (exception-management.md §2).
/// Protected by trigger; corrections are new notes.
model IncidentNote {
  id         String   @id @default(uuid())
  incidentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  author   User     @relation("IncidentNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@schema("app")
}

/// Join between Incident and a stored file. `fileId` stays a plain
/// column until the FileAsset platform model lands (the same
/// deferral pattern TransferItem.incidentId used until this phase).
model IncidentEvidence {
  id           String   @id @default(uuid())
  incidentId   String
  fileId       String
  uploadedById String
  caption      String?
  createdAt    DateTime @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("IncidentEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([incidentId, fileId])
  @@schema("app")
}

/// Customer/vendor support cases (spec Part 4.10). Support can
/// request operational follow-ups (redelivery, address correction)
/// and escalate to investigation tasks, but never touches custody
/// or money from inside a ticket.
model SupportTicket {
  id             String    @id @default(uuid())
  ticketNumber   String    @unique
  category       String
  status         String    @default("OPEN")
  priority       String    @default("NORMAL")
  subject        String
  description    String
  /// Nullable: a phone-verified member of the public can raise a
  /// complaint from the tracking page without an account (the
  /// ticket then carries customerId + contactPhone instead).
  raisedById     String?
  vendorId       String?
  customerId     String?
  packageId      String?
  orderId        String?
  contactPhone   String?
  assignedToId   String?
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  raisedBy   User?                 @relation("TicketRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  assignedTo User?                 @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  resolvedBy User?                 @relation("TicketResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  vendor     Vendor?               @relation("TicketVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  customer   Customer?             @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  package    Package?              @relation("TicketPackage", fields: [packageId], references: [id], onDelete: Restrict)
  order      Order?                @relation("TicketOrder", fields: [orderId], references: [id], onDelete: Restrict)
  messages   SupportTicketMessage[]
  tasks      Task[]                @relation("TaskRelatedTicket")

  @@index([status, priority])
  @@index([vendorId, status])
  @@index([customerId, status])
  @@index([assignedToId, status])
  @@schema("app")
}

/// Ticket communication history — append-only (trigger-protected).
/// INTERNAL messages are staff case notes: they are NEVER returned
/// to the ticket raiser's view.
model SupportTicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  body       String
  visibility String   @default("PUBLIC")
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User          @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@schema("app")
}

/// Per-user / per-recipient notification (spec Part 17) — replaces
/// the legacy global admin feed. Addressed either to an app user
/// (`userId`) or to a package recipient who has no account
/// (`recipientPhone`, normalised; retrieved through the
/// phone-verified tracking channel). One row per (event, channel):
/// `dedupeKey` is unique per channel row, so a retry of the
/// originating event regenerates the same keys and collides instead
/// of double-notifying. `payload` carries structured event data —
/// for DELIVERY_OTP it carries the delivery code itself: the
/// notification IS the delivery mechanism for the code, readable
/// only by its addressee.
model Notification {
  id                  String    @id @default(uuid())
  userId              String?
  recipientPhone      String?
  recipientCustomerId String?
  category            String
  channel             String    @default("IN_APP")
  deliveryStatus      String    @default("SENT")
  title               String
  body                String
  entityType          String?
  entityId            String?
  payload             Json?
  dedupeKey           String?   @unique
  readAt              DateTime?
  createdAt           DateTime  @default(now())

  user              User?     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Restrict)
  recipientCustomer Customer? @relation("NotificationRecipientCustomer", fields: [recipientCustomerId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
  @@index([recipientPhone, category, createdAt])
  @@schema("app")
}

/// Per-user channel preferences (spec Part 17). In-app is always
/// available; EMAIL/SMS rows only take effect when the respective
/// provider keys exist.
model NotificationPreference {
  id       String  @id @default(uuid())
  userId   String
  category String
  channel  String
  enabled  Boolean @default(true)

  user User @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@schema("app")
}
