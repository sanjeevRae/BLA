# Vite exposes only variables prefixed with VITE_ to the browser.
# Use the Supabase ANON key here (never the service key) — RLS protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MAPTILER_API_KEY=your-maptiler-key
# Base URL of the FastAPI backend on Render.
VITE_API_BASE_URL=http://localhost:8000
