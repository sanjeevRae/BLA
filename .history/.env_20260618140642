# =============================================================================
# BLA — Environment variables (example)
# =============================================================================
# Copy to .env and fill in. NEVER commit a real .env. All values are read by the
# FastAPI backend (pydantic-settings). Frontends use their own VITE_*/config.js.
# =============================================================================

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Comma-separated allowed origins for CORS (frontend URLs). Use * only in dev.
CORS_ORIGINS=*

# --- Supabase (primary DB + Realtime + Auth) ---------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_KEY=your-service-role-key
# Direct Postgres connection string (used by psql to apply db/schema.sql & seed).
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Mapping & routing -------------------------------------------------------
MAPTILER_API_KEY=your-maptiler-key
# Fallback routing provider (2,000 directions/day free).
OPENROUTESERVICE_API_KEY=your-openrouteservice-key

# --- Cloudinary (proof-of-delivery photos) -----------------------------------
# Option A: single URL (preferred) ...
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ... OR Option B: individual values (leave CLOUDINARY_URL empty if using these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EmailJS (transactional email: confirmations, daily summary) -------------
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
EMAILJS_USER_ID=your-public-key
# Private key — required for server-side (strict mode) sends.
EMAILJS_PRIVATE_KEY=your-private-key

# --- Textlocal (SMS status updates) ------------------------------------------
TEXTLOCAL_API_KEY=your-textlocal-api-key
TEXTLOCAL_SENDER=TXTLCL

# --- Cron / background tasks -------------------------------------------------
# Shared secret required by the /tasks/* endpoints (set the same value in the
# GitHub Actions / Render Cron secrets).
CRON_TOKEN=change-me

# --- Redis (DEFERRED — only for horizontal scaling) --------------------------
# Leave empty for the single-instance MVP. Set to the Render-managed Redis URL
# when you run multiple backend instances behind the load balancer.
REDIS_URL=
