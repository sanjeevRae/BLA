# =============================================================================
# BLA — Environment variables (example) for the Next.js application
# =============================================================================
# Copy to .env.local (local development) or set in the hosting platform's
# dashboard (production). NEVER commit a real env file. Server-side secrets
# must never be prefixed NEXT_PUBLIC_ and never appear in browser code.
# See docs/deployment-guide.md §3 for the full reference.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection (Supabase POOLER) used by Prisma at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?schema=app
# PostgreSQL DIRECT connection used by Prisma Migrate.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=app

# --- Auth.js ------------------------------------------------------------------
# Session encryption/signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=
# Canonical app URL Auth.js uses for callbacks (also decides the Secure
# cookie prefix: https:// → __Secure- session cookie).
AUTH_URL=http://localhost:3000
# Optional. Header the client IP is read from for login throttling, audit
# records and the public-tracking per-IP limit (default x-forwarded-for).
# Only trustworthy behind a proxy/platform that OVERWRITES the header with
# the real peer address (Vercel does). See src/lib/auth/client-ip.ts.
TRUSTED_IP_HEADER=

# --- MFA (Phase 10 hard gate F13) ---------------------------------------------
# AES-256 key that encrypts privileged users' TOTP secrets at rest
# (User.mfaSecretEncrypted). Base64-encoded 32 random bytes.
# Generate: openssl rand -base64 32
# Losing/rotating this key invalidates every enrolled TOTP secret — all
# SUPER_ADMIN/ADMIN users would have to re-enrol. Store it with the same
# care as DATABASE_URL.
MFA_SECRET_ENCRYPTION_KEY=

# --- Supabase (server-side access where still used) ----------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Bypasses RLS; treat like a DB password.
SUPABASE_SERVICE_KEY=

# --- Uploads / maps / notifications (optional providers) -----------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAPTILER_API_KEY=
OPENROUTESERVICE_API_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=
EMAILJS_PRIVATE_KEY=
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=

# --- Local seed only (development; never used by the running app) --------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
SEED_TEST_WA_PASSWORD=
